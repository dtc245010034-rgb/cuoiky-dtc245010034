# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# Sinh mật khẩu mạnh: openssl rand -base64 33 | tr -d '/+=\n' | cut -c1-24
# KHÔNG commit file .env.

# --- MySQL ---
# Root chỉ đăng nhập trong container; WordPress dùng user riêng chỉ có quyền trên DB của nó.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=CHANGE_ME

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WP_SITE_TITLE="PhucTech Smart Home"
# Tài khoản quản trị tạo bởi wp-cli (scripts/seed.sh)
WP_ADMIN_USER=phuc_admin
WP_ADMIN_PASSWORD=CHANGE_ME
WP_ADMIN_EMAIL=you@example.com

# --- Grafana (không dùng tên mặc định "admin") ---
GRAFANA_ADMIN_USER=phuc_grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Giám sát ---
# User MySQL riêng cho mysqld-exporter (chỉ PROCESS, REPLICATION CLIENT, SELECT trên performance_schema)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=CHANGE_ME
# Basic Auth của Nginx cho Prometheus (9090) và cAdvisor (8082); sinh file: scripts/gen-htpasswd.sh
MONITOR_BASIC_USER=phuc_monitor
MONITOR_BASIC_PASSWORD=CHANGE_ME

# --- Cổng publish ra host (quản trị chỉ bind 127.0.0.1) ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
PHPMYADMIN_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
CADVISOR_PORT=8082
