# Sao chép thành .env: cp .env.example .env   (KHÔNG commit file .env)
# Mật khẩu KHÔNG đặt ở đây: scripts/gen-secrets.sh sinh ngẫu nhiên vào secrets/ (Docker secrets).
# Xem mật khẩu đăng nhập: secrets/wp_admin_password, secrets/grafana_admin_password,
# secrets/monitor_basic_password, secrets/mysql_password.

# --- MySQL ---
# Root chỉ đăng nhập trong container; WordPress dùng user riêng chỉ có quyền trên DB của nó.
# (mật khẩu: secrets/mysql_root_password, secrets/mysql_password)
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# Subnet mạng backend; wp_user/exporter chỉ đăng nhập được từ subnet này (không dùng host '%')
BACKEND_SUBNET=10.250.20.0/24

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WP_SITE_TITLE="PhucTech Smart Home"
# Tài khoản quản trị tạo bởi wp-cli (scripts/seed.sh); mật khẩu: secrets/wp_admin_password
WP_ADMIN_USER=phuc_admin
WP_ADMIN_EMAIL=you@example.com

# --- Grafana (không dùng tên mặc định "admin") ---
GRAFANA_ADMIN_USER=phuc_grafana

# --- Giám sát ---
# User MySQL riêng cho mysqld-exporter (chỉ PROCESS, REPLICATION CLIENT, SELECT trên performance_schema)
MYSQL_EXPORTER_USER=exporter
# Basic Auth của Nginx cho Prometheus (9090), cAdvisor (8082), Loki (3100); mật khẩu: secrets/monitor_basic_password
MONITOR_BASIC_USER=phuc_monitor

# --- Log tập trung ---
# GID của group docker trên host: getent group docker | cut -d: -f3
# (docker-socket-proxy chạy non-root, cần group này để đọc /var/run/docker.sock)
DOCKER_GID=126

# --- Cổng publish ra host (quản trị chỉ bind 127.0.0.1) ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
PHPMYADMIN_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
CADVISOR_PORT=8082
